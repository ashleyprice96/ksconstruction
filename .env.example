# Owner login: used only by migrations and seed scripts.
# On Render, set this to the internal or external Postgres URL (see README).
# DATABASE_URL is accepted as a fallback when DATABASE_URL_OWNER is unset.
DATABASE_URL_OWNER=postgres://ks_owner:change-me@localhost:5432/ks_claims
# Operational login: no access to the commercial schema at all.
# On Render these two can be omitted. bootstrap-roles creates ks_app and
# ks_commercial from APP_DB_PASSWORD and COMMERCIAL_DB_PASSWORD.
DATABASE_URL_APP=postgres://ks_app:change-me@localhost:5432/ks_claims
# Commercial login: used only by the commercial endpoints, after the named-list check.
DATABASE_URL_COMMERCIAL=postgres://ks_commercial:change-me@localhost:5432/ks_claims
# Required on Render so the two logins can be created. Not used for local .env
# when DATABASE_URL_APP and DATABASE_URL_COMMERCIAL are set.
# APP_DB_PASSWORD=
# COMMERCIAL_DB_PASSWORD=
# Where uploaded work photos are stored when STORAGE_DRIVER=postgres.
UPLOAD_DIR=./uploads
# File storage. postgres keeps bytes in the database. s3 uses a private bucket
# (Cloudflare R2, Backblaze B2, or AWS S3). See README.
STORAGE_DRIVER=postgres
# HS_PDF_MAX_MB=50
# STORAGE_QUOTA_GB=1
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=ks-claims-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# ADMIN_EMAIL=admin@example.com
# Set to "true" only when served over HTTPS.
SECURE_COOKIES=false
# Optional. Password-reset requests are always stored in Setup.
# Email is sent only when both RESET_REQUEST_EMAIL and SMTP_HOST are set.
# RESET_REQUEST_EMAIL=office@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
